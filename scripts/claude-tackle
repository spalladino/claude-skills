#!/usr/bin/env bash
# Start an interactive Claude session named tackle-NNN that runs /tackle-issue A-NNN [prompt...]
set -euo pipefail

usage() {
  cat <<USAGE
usage: claude-tackle <ISSUE> [MODEL] [EFFORT] [prompt...]

Starts an interactive Claude session named "tackle-<NNN>" and runs
"/tackle-issue <ISSUE> [prompt...]" as its first message.

  ISSUE    Linear issue: A-2400, a-2400 or 2400 (bare numbers mean team A).
           Other teams keep their prefix in the session name (NET-42 -> tackle-net-42).
  MODEL    optional: fable | opus | sonnet
  EFFORT   optional: xhigh | high | med | medium | low  (med = medium)
  prompt   everything else is passed through to /tackle-issue

MODEL and EFFORT are only recognized right after ISSUE (EFFORT may come
right after ISSUE when MODEL is omitted).

examples:
  claude-tackle A-2400
  claude-tackle 2400 opus high
  claude-tackle a-2400 med the reporter ran v5 on testnet
USAGE
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

case "$1" in
  -h|--help) usage; exit 0 ;;
esac

raw="$1"
shift

if [[ "$raw" =~ ^[0-9]+$ ]]; then
  team="A"
  num="$raw"
elif [[ "$raw" =~ ^([A-Za-z]+)-([0-9]+)$ ]]; then
  team="${BASH_REMATCH[1]^^}"
  num="${BASH_REMATCH[2]}"
else
  echo "claude-tackle: not a Linear identifier: $raw" >&2
  usage >&2
  exit 1
fi

issue="${team}-${num}"
if [[ "$team" == "A" ]]; then
  name="tackle-${num}"
else
  name="tackle-${team,,}-${num}"
fi

args=(--name "$name")

if [[ $# -gt 0 ]]; then
  case "$1" in
    fable|opus|sonnet) args+=(--model "$1"); shift ;;
  esac
fi

if [[ $# -gt 0 ]]; then
  case "$1" in
    xhigh|high|medium|low) args+=(--effort "$1"); shift ;;
    med) args+=(--effort medium); shift ;;
  esac
fi

exec claude "${args[@]}" "/tackle-issue ${issue}${*:+ $*}"
