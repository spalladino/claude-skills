#!/usr/bin/env bash
# Start an interactive Claude session named tackle-NNN that runs /tackle-issue A-NNN [prompt...]
set -euo pipefail

usage() {
  cat <<USAGE
usage: claude-tackle <ISSUE> [MODEL] [EFFORT] [prompt...]

Starts an interactive Claude session named "tackle-<NNN>-<slug>" and runs
"/tackle-issue <ISSUE> [prompt...]" as its first message. The slug comes from
the issue's suggested branch name in Linear, read with a personal API key from
\$LINEAR_API_KEY or ~/.config/linear/api-key; without one, or if Linear does
not answer within 3s, the name is just "tackle-<NNN>".

  ISSUE    Linear issue: A-2400, a-2400 or 2400 (bare numbers mean team A).
           Other teams keep their prefix in the session name (NET-42 -> tackle-net-42).
  MODEL    optional: fable | opus | sonnet
  EFFORT   optional: xhigh | high | med | medium | low  (med = medium)
  prompt   everything else is passed through to /tackle-issue

MODEL and EFFORT are only recognized right after ISSUE (EFFORT may come
right after ISSUE when MODEL is omitted).

examples:
  claude-tackle A-2400
  claude-tackle 2400 opus high
  claude-tackle a-2400 med the reporter ran v5 on testnet
USAGE
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

case "$1" in
  -h|--help) usage; exit 0 ;;
esac

raw="$1"
shift

if [[ "$raw" =~ ^[0-9]+$ ]]; then
  team="A"
  num="$raw"
elif [[ "$raw" =~ ^([A-Za-z]+)-([0-9]+)$ ]]; then
  team="${BASH_REMATCH[1]^^}"
  num="${BASH_REMATCH[2]}"
else
  echo "claude-tackle: not a Linear identifier: $raw" >&2
  usage >&2
  exit 1
fi

issue="${team}-${num}"
if [[ "$team" == "A" ]]; then
  name="tackle-${num}"
else
  name="tackle-${team,,}-${num}"
fi

# Append the slug of Linear's suggested branch name (spl/a-2400-fix-x -> fix-x).
# Best effort: without a key, or if Linear is slow or down, keep the bare name.
linear_key() {
  if [[ -n "${LINEAR_API_KEY:-}" ]]; then
    printf '%s' "$LINEAR_API_KEY"
  elif [[ -r "$HOME/.config/linear/api-key" ]]; then
    tr -d '[:space:]' < "$HOME/.config/linear/api-key"
  fi
}

issue_slug() {
  local key fields title branch slug tag
  key="$(linear_key)"
  [[ -n "$key" ]] || return 0
  fields="$(curl -sf --max-time 3 https://api.linear.app/graphql \
    -H "Authorization: $key" -H 'Content-Type: application/json' \
    -d "{\"query\":\"query(\$id:String!){issue(id:\$id){title branchName}}\",\"variables\":{\"id\":\"$issue\"}}" \
    | jq -r '.data.issue // empty | "\(.title // "")\t\(.branchName // "")"' 2>/dev/null)" || return 0
  IFS=$'\t' read -r title branch <<< "$fields"
  branch="${branch##*/}"
  branch="${branch,,}"
  [[ "$branch" == "${issue,,}-"* ]] || return 0
  slug="${branch#"${issue,,}-"}"
  # A title tag like "[aztec-node] ..." also leads the branch slug; drop it.
  if [[ "$title" =~ ^\[([^]]+)\] ]]; then
    tag="$(printf '%s' "${BASH_REMATCH[1],,}" | tr -cs 'a-z0-9' '-')"
    tag="${tag#-}"
    tag="${tag%-}"
    [[ -n "$tag" ]] && slug="${slug#"${tag}-"}"
  fi
  printf '%s' "$slug"
}

slug="$(issue_slug)"
if [[ -n "$slug" ]]; then
  name="${name}-${slug}"
  if (( ${#name} > 48 )); then
    name="${name:0:49}"
    name="${name%-*}"
  fi
fi

args=(--name "$name")

if [[ $# -gt 0 ]]; then
  case "$1" in
    fable|opus|sonnet) args+=(--model "$1"); shift ;;
  esac
fi

if [[ $# -gt 0 ]]; then
  case "$1" in
    xhigh|high|medium|low) args+=(--effort "$1"); shift ;;
    med) args+=(--effort medium); shift ;;
  esac
fi

exec claude "${args[@]}" "/tackle-issue ${issue}${*:+ $*}"
