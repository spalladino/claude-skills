#!/usr/bin/env bash
# Start an interactive Claude session named review-pr-NNN that runs /review-pr NNN [prompt...]
set -euo pipefail

usage() {
  cat <<USAGE
usage: claude-review-pr <PR> [MODEL] [EFFORT] [prompt...]

Starts an interactive Claude session named "review-pr-<PR>-<slug>" and runs
"/review-pr <PR> [prompt...]" as its first message. The slug comes from the
PR title in the current directory's GitHub repo; if gh cannot fetch it within
5s, the name is just "review-pr-<PR>".

  PR       pull request number
  MODEL    optional: fable | opus | sonnet
  EFFORT   optional: xhigh | high | med | medium | low  (med = medium)
  prompt   everything else is passed through to /review-pr

MODEL and EFFORT are only recognized right after PR (EFFORT may come
right after PR when MODEL is omitted).

examples:
  claude-review-pr 1234
  claude-review-pr 1234 opus high
  claude-review-pr 1234 med focus on the p2p changes
USAGE
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

case "$1" in
  -h|--help) usage; exit 0 ;;
esac

pr="$1"
shift

name="review-pr-${pr}"

# Append a slug of the PR title (feat(p2p): Drop stale peers -> drop-stale-peers).
# Best effort: outside a GitHub repo, or if gh is slow or fails, keep the bare name.
title="$(timeout 5 gh api "repos/{owner}/{repo}/pulls/${pr}" --jq .title 2>/dev/null)" || title=""
title="$(sed -E 's/^\[[^]]*\][[:space:]]*//; s/^[a-z]+(\([^)]*\))?!?:[[:space:]]*//' <<< "$title")"
slug="$(printf '%s' "${title,,}" | tr -cs 'a-z0-9' '-')"
slug="${slug#-}"
slug="${slug%-}"
if [[ -n "$slug" ]]; then
  name="${name}-${slug}"
  if (( ${#name} > 48 )); then
    name="${name:0:49}"
    name="${name%-*}"
  fi
fi

args=(--name "$name")

if [[ $# -gt 0 ]]; then
  case "$1" in
    fable|opus|sonnet) args+=(--model "$1"); shift ;;
  esac
fi

if [[ $# -gt 0 ]]; then
  case "$1" in
    xhigh|high|medium|low) args+=(--effort "$1"); shift ;;
    med) args+=(--effort medium); shift ;;
  esac
fi

exec claude "${args[@]}" "/review-pr ${pr}${*:+ $*}"
